build /root/autodl-tmp/Octree-GS/Octree-GS/submodules/simple-knn/build/temp.linux-x86_64-cpython-310/simple_knn.o: cuda_compile /root/autodl-tmp/Octree-GS/Octree-GS/submodules/simple-knn/simple_knn.cu
build /root/autodl-tmp/Octree-GS/Octree-GS/submodules/simple-knn/build/temp.linux-x86_64-cpython-310/spatial.o: cuda_compile /root/autodl-tmp/Octree-GS/Octree-GS/submodules/simple-knn/spatial.cu








